# ============================================================
# AI Nexus Core — Plantilla de variables de entorno
# Copia este archivo como .env y rellena tus propias claves.
# NUNCA subas .env al repositorio (está en .gitignore).
# ============================================================

# --- GitHub (requerido por github-scout y portfolio-git) ---
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_tu_token_aqui
GITHUB_USERNAME=tu_usuario_github

# --- NVIDIA NIM Cloud API (fallback de costo cero del modelo local) ---
NVIDIA_API_KEY=nvapi_tu_clave_aqui

# --- Ollama (modelo local, sin clave) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Hugging Face (opcional, para ml-deeplearning-specialist) ---
HF_TOKEN=hf_tu_token_aqui
