{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "orange", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": { "base": "$text.muted", "$hovered": "$text.base" },
        "destructive": { "base": "$hue.neutral.800", "$disabled": "$hue.neutral.400" }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.cyan.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": { "base": "$hue.neutral.700", "high": "$hue.neutral.600", "max": "$hue.neutral.500" },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#282828" },
    "scrollbar": { "base": "#505050" },
    "diff": {
      "text": { "added": "#4fd6be", "removed": "#c53b53", "context": "#8b8b8b", "hunkHeader": "#8b8b8b" },
      "background": { "added": "#0d2818", "removed": "#281a1a", "context": "$hue.neutral.700" },
      "highlight": { "added": "#b8db87", "removed": "#e26a75" },
      "lineNumber": { "text": "#8f8f8f", "background": { "added": "#1b2b34", "removed": "#2d1f26" } }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.cyan.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.200",
      "number": "#fbbf24",
      "type": "$hue.red.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.300"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.accent.200",
      "link": "$hue.purple.200",
      "linkText": "$hue.neutral.200",
      "code": "$hue.cyan.200",
      "blockQuote": "#8b8b8b",
      "emphasis": "$hue.neutral.200",
      "strong": "$hue.neutral.200",
      "horizontalRule": "#282828",
      "listItem": "$hue.neutral.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.purple.200",
      "imageText": "$hue.neutral.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": { "primary": { "$hovered": "$background.raised.high" } }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff", "200": "#ffffff", "300": "#d4d4d4", "400": "#A0A0A0",
        "500": "#505050", "600": "#282828", "700": "#161616", "800": "#101010", "900": "#0b0b0b"
      },
      "red": {
        "100": "#fca5a5", "200": "#f87171", "300": "#ef4444", "400": "#dc2626",
        "500": "#b91c1c", "600": "#991b1b", "700": "#7f1d1d", "800": "#671010", "900": "#450a0a"
      },
      "orange": {
        "100": "#fdba74", "200": "#fb923c", "300": "#f97316", "400": "#ea580c",
        "500": "#c2410c", "600": "#9a3412", "700": "#7c2d12", "800": "#431407", "900": "#2a0e04"
      },
      "green": {
        "100": "#86efac", "200": "#34d399", "300": "#22c55e", "400": "#16a34a",
        "500": "#15803d", "600": "#166534", "700": "#14532d", "800": "#052e16", "900": "#022c12"
      },
      "cyan": {
        "100": "#67e8f9", "200": "#22d3ee", "300": "#06b6d4", "400": "#0891b2",
        "500": "#0e7490", "600": "#155e75", "700": "#164e63", "800": "#0e3a47", "900": "#082c36"
      },
      "blue": {
        "100": "#93c5fd", "200": "#60a5fa", "300": "#3b82f6", "400": "#2563eb",
        "500": "#1d4ed8", "600": "#1e40af", "700": "#1e3a8a", "800": "#172554", "900": "#0c1830"
      },
      "purple": {
        "100": "#d8b4fe", "200": "#c084fc", "300": "#a855f7", "400": "#9333ea",
        "500": "#7e22ce", "600": "#6b21a8", "700": "#581c87", "800": "#3b0764", "900": "#2e0a49"
      },
      "accent": "$hue.cyan",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
