{
  "$schema": "https://opencode.ai/tui.theme.json",
  "name": "ai-nexus-core-chat",
  "description": "Tema visual OLED unificado v5 — paleta Nexus sofisticada para Open Code. Fondo profundo #020617, acento cian neón #22d3ee, púrpura eléctrico #8b5cf6, vidrio difuminado. Coordinado con Warp. Cero consumo de tokens.",
  "author": "AFelipeRD",
  "version": "5.0.0",

  "base": {
    "text": {
      "base": "#f8fafc",
      "muted": "#94a3b8",
      "inverse": "#020617",
      "accent": "#22d3ee",
      "secondary": "#8b5cf6",
      "tertiary": "#38bdf8"
    },
    "background": {
      "base": "#020617"
    },
    "border": {
      "base": "#1e293b",
      "active": "#22d3ee",
      "subtle": "#1e293b",
      "secondary": "#8b5cf6"
    },
    "scrollbar": {
      "track": "#030712",
      "thumb": "#1e293b"
    },
    "diff": {
      "text": {
        "added": "#34d399",
        "removed": "#f87171"
      },
      "context": "#64748b",
      "highlight": "#22d3ee",
      "line-number": "#475569"
    },
    "syntax": {
      "comment": "#64748b",
      "keyword": "#c084fc",
      "function": "#22d3ee",
      "variable": "#f8fafc",
      "string": "#34d399",
      "number": "#fbbf24",
      "type": "#8b5cf6",
      "operator": "#22d3ee",
      "punctuation": "#94a3b8"
    },
    "markdown": {
      "text": "#f8fafc",
      "heading": "#22d3ee",
      "link": "#8b5cf6",
      "linkText": "#f8fafc",
      "code": "#22d3ee",
      "blockQuote": "#64748b",
      "emphasis": "#f8fafc",
      "strong": "#f8fafc",
      "horizontalRule": "#1e293b",
      "listItem": "#f8fafc",
      "listEnumeration": "#22d3ee",
      "image": "#f8fafc",
      "imageText": "#f8fafc",
      "codeBlock": "#030712"
    },
    "panel": {
      "background": "#030712",
      "border": "#1e293b",
      "title": "#22d3ee",
      "text": "#f8fafc",
      "borderActive": "#22d3ee"
    },
    "input": {
      "background": "#030712",
      "foreground": "#f8fafc",
      "border": "#1e293b",
      "borderFocused": "#22d3ee",
      "placeholder": "#64748b"
    },
    "button": {
      "background": "#22d3ee",
      "foreground": "#020617",
      "hover": "#38bdf8",
      "disabled": "#475569"
    },
    "alert": {
      "success": { "background": "#064e3b", "text": "#34d399", "border": "#34d399" },
      "warning": { "background": "#713f12", "text": "#fbbf24", "border": "#fbbf24" },
      "error": { "background": "#7f1d1d", "text": "#f87171", "border": "#f87171" },
      "info": { "background": "#0f172a", "text": "#22d3ee", "border": "#22d3ee" }
    },
    "terminal": {
      "background": "#020617",
      "foreground": "#f8fafc",
      "cursor": "#22d3ee",
      "selection": "#1e293b",
      "black": "#0f172a",
      "red": "#f87171",
      "green": "#34d399",
      "yellow": "#fbbf24",
      "blue": "#22d3ee",
      "magenta": "#8b5cf6",
      "cyan": "#22d3ee",
      "white": "#f8fafc",
      "brightBlack": "#475569",
      "brightRed": "#fb7185",
      "brightGreen": "#4ade80",
      "brightYellow": "#fcd34d",
      "brightBlue": "#38bdf8",
      "brightMagenta": "#d8b4fe",
      "brightCyan": "#67e8f9",
      "brightWhite": "#ffffff"
    },
    "tabs": {
      "background": "#030712",
      "foreground": "#94a3b8",
      "active": { "background": "#020617", "foreground": "#22d3ee", "border": "#22d3ee" },
      "border": "#1e293b"
    },
    "debug": {
      "breakpoint": "#f87171",
      "currentLine": "#1e293b",
      "variable": "#34d399",
      "value": "#22d3ee"
    }
  },

  "light": {
    "hue": {}
  },

  "dark": {
    "hue": {
      "accent": "$hue.cyan",
      "interactive": "$hue.blue",
      "neutral": "$hue.slate",
      "secondary": "$hue.purple",
      "tertiary": "$hue.cyan"
    },
    "text": {
      "base": "#f8fafc",
      "muted": "#94a3b8",
      "inverse": "#020617",
      "accent": "#22d3ee",
      "secondary": "#8b5cf6",
      "tertiary": "#38bdf8"
    },
    "background": {
      "base": "#020617",
      "raised": {
        "base": "#030712",
        "high": "#070c18",
        "max": "#0f172a"
      }
    },
    "border": {
      "base": "#1e293b",
      "active": "#22d3ee",
      "subtle": "#1e293b",
      "secondary": "#8b5cf6"
    }
  }
}
