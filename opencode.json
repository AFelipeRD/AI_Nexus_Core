{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/z-ai/glm-5.3",
  "small_model": "nvidia/z-ai/glm-5.3",
  "default_agent": "orchestrator",
  "share": "disabled",
  "autoupdate": false,
  "instructions": [
    "MEMORY.md",
    ".opencode/context/convenciones-codigo.md"
  ],
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA Build NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3": {
          "name": "GLM 5.3 (Z-AI)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, costo cero)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm *": "ask",
      "del *": "ask",
      "Remove-Item*": "ask"
    },
    "webfetch": "allow"
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\AI_Nexus_Core"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "n8n": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "enabled": false
    },
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "enabled": false
    },
    "claude-mem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "claude-mem",
        "mcp"
      ],
      "enabled": true
    },
    "mem0": {
      "type": "local",
      "command": [
        "uvx",
        "mem0-mcp-server"
      ],
      "enabled": false
    },
    "huggingface": {
      "type": "remote",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer {env:HF_TOKEN}"
      },
      "enabled": false
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    }
  }
}