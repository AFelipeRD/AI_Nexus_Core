# Job Search Telegram Bot — Variables de entorno
# Copia este archivo a .env y completa los valores

# Telegram Bot Token (obténlo de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Tu Chat ID (obténlo escribiendo /start a @userinfobot o @getmyid_bot)
TELEGRAM_CHAT_ID=123456789

# Webhook URL (opcional - para producción con dominio público)
# Si no configuras esto, el bot usará polling (consultando cada segundo)
# Para webhook necesitas: dominio con HTTPS + ngrok/cloudflare tunnel
# TELEGRAM_WEBHOOK_URL=https://tu-dominio.com

# Puerto del servidor webhook (si usas webhook)
TELEGRAM_BOT_PORT=8080